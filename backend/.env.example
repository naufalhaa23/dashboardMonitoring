# ── MQTT Broker (IoT Device) ────────────────────────
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=sensor/power_meter
MQTT_USERNAME=
MQTT_PASSWORD=


# ── InfluxDB v2 ─────────────────────────────────────
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=my-token
INFLUX_ORG=my-org
INFLUX_BUCKET=power_monitor

# ── Tarif Listrik (Rp/kWh) ──────────────────────────
TARIFF_WBP=1444.70
TARIFF_LWBP=1114.74
WBP_START_HOUR=18
WBP_END_HOUR=22

# ── Server ───────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=3001

# ── Mode ─────────────────────────────────────────────
# Set to 'true' to use simulated MQTT payloads
MOCK_MQTT=true
